# Streamlit Community Cloud: paste these into
#   your app -> Settings -> Secrets
# Locally you do NOT need this file - .env is used instead.
#
# NEVER commit the real secrets.toml. .gitignore already excludes it.

PGHOST = "aws-0-eu-central-1.pooler.supabase.com"
PGPORT = "5432"
PGDATABASE = "postgres"
PGUSER = "postgres.your-project-ref"
PGPASSWORD = "your-database-password"
