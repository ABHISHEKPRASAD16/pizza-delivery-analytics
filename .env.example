# Supabase -> Connect -> Direct connection string -> SESSION POOLER
#
# Example session pooler URI:
#   postgresql://postgres.abcdefghij:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#                └───── PGUSER ────┘           └────────────── PGHOST ──────────────┘ └PORT┘ └ DB ┘
#
# PGUSER must keep the .projectref suffix. Plain "postgres" will not authenticate.
PGHOST=aws-0-eu-central-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=your-database-password
