# secrets - never commit
.env
.streamlit/secrets.toml

# python
__pycache__/
*.pyc
.ipynb_checkpoints/

# generated data (rebuild with generate_data.py, or read from Supabase)
data/raw/*
data/processed/*
!data/**/.gitkeep

# power bi
# The report file itself IS committed - it is the deliverable, and it carries
# no credentials (Power BI keeps those in the local credential store, not in
# the .pbix). Scanned before committing: no host, project ref or password.
*.pbix
!dashboard/Pizza_Analytics.pbix
